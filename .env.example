# ===========================================================================
# PROVEEDOR DE IA
#   ollama -> 100% local, sin claves ni costos (por defecto)
#   openai -> usa la API de OpenAI en la nube (requiere OPENAI_API_KEY)
# ===========================================================================
LLM_PROVIDER=ollama

# --- Administrador inicial de la app (requerido para poder iniciar sesión) ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave

# Semilla para firmar los enlaces de invitación (opcional, recomendada)
# Si no se define, los enlaces dejan de valer cada vez que la app se reinicia.
INVITE_SEED=una-frase-larga-y-secreta

# --- Servidor web (Flask) ---
# Clave para firmar las cookies de sesión (ponla fija en producción).
FLASK_SECRET_KEY=cambia-esto-por-algo-aleatorio-y-largo
# Puerto local donde se abre la app.
PORT=8501

# ===========================================================================
# MODO LOCAL (LLM_PROVIDER=ollama)
# Descarga los modelos una vez con:
#   ollama pull qwen2.5:7b-instruct
#   ollama pull nomic-embed-text
#   ollama pull llava:7b          # solo si usas análisis de imágenes
# ===========================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava:7b

# Transcripción local (faster-whisper): tiny | base | small | medium | large-v3
# y dispositivo: auto | cuda | cpu. "small" va bien en español.
WHISPER_MODEL=small
WHISPER_DEVICE=auto

# ===========================================================================
# MODO NUBE (solo si LLM_PROVIDER=openai)
# ===========================================================================
OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_CHAT_MODEL=gpt-3.5-turbo

# Configuración opcional de Streamlit
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true
